# Exclusiva del servidor. Opcional para la página inicial y el build.
# Configúrala en .env.local antes de iniciar Next o compilar para reenviar
# las rutas de autenticación y mercados a FastAPI.
# Origen fijo del servicio FastAPI; sin ruta, usuario, contraseña, query ni fragmento.
API_INTERNAL_ORIGIN=http://127.0.0.1:8000
